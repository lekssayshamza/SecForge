# PLACEHOLDERS ONLY. Copy only when .env does not already exist; see README.md.
# Local development uses synthetic lifecycle operations and no AWS/VPN access.
PRODUCTION=false
DATABASE_URL=sqlite:///./.local/secforge.sqlite
JWT_SECRET=<GENERATE_LOCAL_JWT_SECRET>
CHALLENGE_ANSWER_KEY=<GENERATE_LOCAL_VERIFICATION_KEY>
EDITABLE_ANSWER_KEY=<GENERATE_LOCAL_BASE64URL_AES256_KEY>
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_OAUTH_ENABLED=false

TERRAFORM_DRY_RUN=true
RECONCILIATION_ENABLED=false
VPN_ENABLED=false
VPN_AUTHZ_ENABLED=false
VPN_BACKEND_AUTHZ_ENABLED=false
BUILDER_INTERNET_ENABLED=false
# Export AWS_EC2_METADATA_DISABLED=true in the shell (an AWS SDK option,
# not a SecForge dotenv setting); see README.md.

# Paths are relative to backend/. These override operator-specific defaults.
AVATAR_STORAGE_DIR=.local/avatars
BUILDER_TERRAFORM_SOURCE_DIR=../infrastructure/terraform/builder
LAB_TERRAFORM_SOURCE_DIR=../infrastructure/terraform/lab
BUILDER_TERRAFORM_WORKSPACE_ROOT=.local/builders
LAB_TERRAFORM_WORKSPACE_ROOT=.local/labs
TERRAFORM_PLUGIN_CACHE_DIR=.local/terraform-cache

# Deliberately unusable placeholders; never copy production credentials here.
BUILDER_AMI_ID=<APPROVED_BUILDER_AMI_ID>
BUILDER_VPC_ID=<APPROVED_VPC_ID>
BUILDER_SUBNET_ID=<APPROVED_PRIVATE_SUBNET_ID>
BUILDER_SSH_KEY_NAME=<APPROVED_EC2_KEY_PAIR_NAME>
TERRAFORM_STATE_BUCKET=<APPROVED_PRIVATE_STATE_BUCKET>
VPN_GATEWAY_HOST=<APPROVED_VPN_HOST>
VPN_GATEWAY_MANAGEMENT_HOST=
VPN_GATEWAY_SSH_KEY_PATH=
BUILDER_SSH_KEY_PATH=
BUILDER_MANAGEMENT_SECURITY_GROUP_ID=
